---
import BaseLayout from '../layouts/BaseLayout.astro';
import CtaSection from '../components/CtaSection.astro';
import TestimonialsCarousel from '../components/TestimonialsCarousel.astro';
import LeadMagnet from '../components/LeadMagnet.astro';

const schema = [{
  "@context": "https://schema.org",
  "@type": "FinancialService",
  "@id": "https://www.simplewealth.co.za/#organization",
  "name": "Simple Wealth",
  "alternateName": "Simple Wealth (Pty) Ltd",
  "description": "Independent financial planning from Ballito on the KZN north coast. We help affluent families align their wealth with their values, lifestyle, and long-term goals.",
  "url": "https://www.simplewealth.co.za",
  "image": "https://www.simplewealth.co.za/images/hero-adviser.webp",
  "logo": "https://www.simplewealth.co.za/logo.png",
  "telephone": "087 012 5628",
  "email": "info@simplewealth.co.za",
  "address": {
    "@type": "PostalAddress",
    "streetAddress": "Office 7.17, Workshop17, 7th Floor, Ballito Junction Regional Mall, Leonora Dr",
    "addressLocality": "Ballito",
    "addressRegion": "KwaZulu-Natal",
    "postalCode": "4399",
    "addressCountry": "ZA"
  },
  "geo": { "@type": "GeoCoordinates", "latitude": -29.5266659, "longitude": 31.2036188 },
  "hasMap": "https://maps.app.goo.gl/z5PbmNjmUYrW6vDD7",
  "areaServed": [
    { "@type": "Country", "name": "South Africa" },
    { "@type": "AdministrativeArea", "name": "KwaZulu-Natal" },
    { "@type": "City", "name": "Ballito" },
    { "@type": "City", "name": "Umhlali" }
  ],
  "serviceType": ["Investment Planning", "Risk Planning", "Estate Planning", "Tax Planning"],
  "priceRange": "$$",
  "founder": {
    "@type": "Person",
    "name": "Pierre Taljaard",
    "jobTitle": "Director & Financial Planner",
    "hasCredential": [
      { "@type": "EducationalOccupationalCredential", "credentialCategory": "Professional Certification", "name": "Certified Financial Planner (CFP)" },
      { "@type": "EducationalOccupationalCredential", "credentialCategory": "Professional Certification", "name": "CFA Charterholder" }
    ]
  },
  "hasCredential": {
    "@type": "EducationalOccupationalCredential",
    "credentialCategory": "Regulatory License",
    "name": "Financial Services Provider Licence",
    "recognizedBy": { "@type": "GovernmentOrganization", "name": "Financial Sector Conduct Authority (FSCA)" },
    "identifier": "FSP 50637"
  },
  "knowsAbout": ["financial planning", "investment planning", "tax planning", "estate planning", "risk planning", "wealth management", "retirement planning", "retirement income planning", "offshore investment strategy", "drawdown sustainability", "decumulation strategy", "living annuity structuring", "currency diversification", "sequence-of-returns risk", "multi-vehicle tax optimisation", "KZN north coast financial adviser", "Ballito financial planner", "KwaZulu-Natal independent financial adviser"],
  "foundingDate": "2020-04-01",
  "sameAs": ["https://www.linkedin.com/in/ptaljaard/", "https://www.pierretaljaard.com/", "https://g.page/simple-wealth-fp"]
}, {
  "@context": "https://schema.org",
  "@type": "WebSite",
  "name": "Simple Wealth",
  "url": "https://www.simplewealth.co.za"
}, {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    { "@type": "Question", "name": "Do you only work with high-net-worth individuals?", "acceptedAnswer": { "@type": "Answer", "text": "While we serve many clients with significant assets, we provide a professional and proactive financial planning service to any family willing to engage and pay for professional advice. We don't have account minimums, but our minimum annual fee means that clients with investable assets below R2 million may not find our service cost-effective." } },
    { "@type": "Question", "name": "What does this cost and what exactly am I paying for?", "acceptedAnswer": { "@type": "Answer", "text": "We charge a percentage-based fee on your investable assets. This covers our comprehensive proactive service across investments, tax, estate planning, and risk planning. We are not remunerated by any product providers, so our incentives are fully aligned with yours. Clients are free to disengage at any time if the perceived value is less than our fee." } },
    { "@type": "Question", "name": "How do I know you're acting in my best interest?", "acceptedAnswer": { "@type": "Answer", "text": "As a client-centred firm with no outside influence from product providers, our only incentive is to provide professional advice that results in happy clients." } },
    { "@type": "Question", "name": "What kind of results should I realistically expect?", "acceptedAnswer": { "@type": "Answer", "text": "If you actively engage with our services, you should expect long-term peace of mind and progress towards your goals. The portfolios we build are typically focused on long-term growth, which inevitably means short-term volatility and temporary declines from time to time. Our service is designed for families who understand that long-term planning requires discipline and patience." } },
    { "@type": "Question", "name": "How often will we review things, and how quickly can I reach you?", "acceptedAnswer": { "@type": "Answer", "text": "Our service calendar provides quarterly touchpoints, but we remain available for questions at any time in between. You can expect responses within one business day, and we proactively reach out when market conditions or life changes warrant a conversation. We have purposefully built a service model and client base that allow us to be available to our clients." } }
  ]
}];
---

<BaseLayout
  title="Independent Financial Planning, Ballito | Simple Wealth"
  description="Independent financial planning from Ballito, KZN north coast. We align your wealth with your values, lifestyle, and long-term goals."
  schema={schema}
>
  <link rel="preload" href="/images/hero-adviser-mobile.webp" as="image" type="image/webp" media="(max-width: 768px)" slot="head">
  <link rel="preload" href="/images/hero-adviser.webp" as="image" type="image/webp" media="(min-width: 769px)" slot="head">

  <div class="v2">

  <!-- First screen: hero and promise band together fill the viewport -->
  <div class="hv-fold">

  <!-- Hero -->
  <section class="hero hero--bg-photo">
    <div class="hero__bg">
      <picture>
        <source srcset="/images/hero-adviser-mobile.webp" media="(max-width: 768px)" type="image/webp">
        <img src="/images/hero-adviser.webp" alt="Multigenerational family sharing a meal together outdoors" width="1920" height="1280" loading="eager" fetchpriority="high">
      </picture>
    </div>
    <div class="hero__inner">
      <h1 class="fade-up">Financial <em class="hero-highlight">clarity</em> for the life you've built</h1>
      <div class="hv-hero__side">
        <p class="fade-up">Expert financial planning that carefully aligns your money with your values, lifestyle, and long-term goals.</p>
        <div class="btn-group fade-up">
          <a href="/contact/" class="btn btn--primary">Book a free call</a>
          <a href="#services" class="btn btn--outline-white">How we help</a>
        </div>
        <div class="social-proof fade-up">
          <div class="avatar-stack">
            <span class="avatar-initial"><svg width="16" height="16" viewBox="0 0 24 24"><path fill="var(--color-gold)" d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg></span>
            <span class="avatar-initial"><svg width="16" height="16" viewBox="0 0 24 24"><path fill="var(--color-gold)" d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg></span>
            <span class="avatar-initial"><svg width="16" height="16" viewBox="0 0 24 24"><path fill="var(--color-gold)" d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg></span>
            <span class="avatar-initial"><svg width="16" height="16" viewBox="0 0 24 24"><path fill="var(--color-gold)" d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg></span>
            <span class="avatar-initial"><svg width="16" height="16" viewBox="0 0 24 24"><path fill="var(--color-gold)" d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg></span>
          </div>
          <div class="social-proof__text"><a href="#testimonials" class="social-proof__link"><strong>5.0 star rated</strong></a> &mdash; Trusted by families across South Africa</div>
        </div>
      </div>
    </div>
  </section>

  <!-- Promise band -->
  <div class="hv-band">
    <ul class="hv-band__list">
      <li>Clarity</li>
      <li>Peace of mind</li>
      <li>Independent advice</li>
    </ul>
  </div>

  </div>

  <!-- Problem Section -->
  <section class="section hv-problem hv-navy" id="problems">
    <div class="container">
      <div class="hv-lede fade-up">
        <h2>Managing your financial life can feel <em>complex, time consuming, and risky</em></h2>
        <p>Do any of these problems sound familiar?</p>
      </div>
      <ul class="hv-cols">
        <li class="hv-col fade-up"><span class="hv-icon"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg></span><h3>You're busy</h3><p>Planning your future takes time and focus that life doesn't always allow.</p></li>
        <li class="hv-col fade-up"><span class="hv-icon"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"/><path d="M12 17h.01"/></svg></span><h3>You don't know what you don't know</h3><p>Making important decisions about your future feels daunting without the right guidance.</p></li>
        <li class="hv-col fade-up"><span class="hv-icon"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"/><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/></svg></span><h3>You're overwhelmed</h3><p>Tax, retirement, investments, and estate planning all have many interconnected parts.</p></li>
        <li class="hv-col fade-up"><span class="hv-icon"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M10.1 2.18a9.93 9.93 0 0 1 3.8 0"/><path d="M17.6 3.71a9.95 9.95 0 0 1 2.69 2.7"/><path d="M21.82 10.1a9.93 9.93 0 0 1 0 3.8"/><path d="M20.29 17.6a9.95 9.95 0 0 1-2.7 2.69"/><path d="M13.9 21.82a9.94 9.94 0 0 1-3.8 0"/><path d="M6.4 20.29a9.95 9.95 0 0 1-2.69-2.7"/><path d="M2.18 13.9a9.93 9.93 0 0 1 0-3.8"/><path d="M3.71 6.4a9.95 9.95 0 0 1 2.7-2.69"/></svg></span><h3>Uncertainty is holding you back</h3><p>Without a clear plan, it's easy to put off the decisions that matter most.</p></li>
      </ul>
    </div>
  </section>

  <!-- Solution Section -->
  <section class="section hv-paper" id="solution">
    <div class="container hv-split">
      <div class="hv-split__intro fade-up">
        <h2>We help busy families <em>take control</em> of their financial future.</h2>
        <p>Our clients experience the following benefits from working with us.</p>
      </div>
      <div class="hv-split__body">
        <ul class="hv-pairs">
          <li class="hv-pair fade-up"><span class="hv-icon"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M10 2v2"/><path d="M14 2v2"/><path d="M16 8a1 1 0 0 1 1 1v8a4 4 0 0 1-4 4H7a4 4 0 0 1-4-4V9a1 1 0 0 1 1-1h14a2 2 0 1 1 0 4h-2"/><path d="M6 2v2"/></svg></span><h3>More time to enjoy your life</h3><p>We remove the burden of wealth management so you can focus on living.</p></li>
          <li class="hv-pair fade-up"><span class="hv-icon"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg></span><h3>A trusted partner by your side</h3><p>Regular check-ins and ongoing support through every decision and milestone.</p></li>
          <li class="hv-pair fade-up"><span class="hv-icon"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><circle cx="12" cy="12" r="6"/><circle cx="12" cy="12" r="2"/></svg></span><h3>Confidence in every decision</h3><p>No confusion. Just clear advice you can act on.</p></li>
          <li class="hv-pair fade-up"><span class="hv-icon"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14.106 5.553a2 2 0 0 0 1.788 0l3.659-1.83A1 1 0 0 1 21 4.619v12.764a1 1 0 0 1-.553.894l-4.553 2.277a2 2 0 0 1-1.788 0l-4.212-2.106a2 2 0 0 0-1.788 0l-3.659 1.83A1 1 0 0 1 3 19.381V6.618a1 1 0 0 1 .553-.894l4.553-2.277a2 2 0 0 1 1.788 0z"/><path d="M15 5.764v15"/><path d="M9 3.236v15"/></svg></span><h3>A clear plan for what's ahead</h3><p>A step-by-step roadmap so you always know the next step.</p></li>
        </ul>
        <div class="hv-cta fade-up"><a href="/contact/" class="btn btn--primary">Book a free call</a></div>
      </div>
    </div>
  </section>

  <TestimonialsCarousel grey={false} perView={1} />

  <!-- Services Section -->
  <section class="section" id="services">
    <div class="container">
      <div class="hv-lede fade-up">
        <h2>How we help you</h2>
        <p>We provide expert guidance across four key areas of financial planning.</p>
      </div>
      <div class="hv-services">
        <article class="hv-service fade-up"><h3>Investment planning</h3><div class="hv-service__main"><h4>A plan for diversified long-term growth</h4><p>A disciplined strategy to turn your income into lasting wealth.</p></div><a href="/investment-planning/" class="hv-service__link">Learn more about investment planning <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg></a></article>
        <article class="hv-service fade-up"><h3>Tax planning</h3><div class="hv-service__main"><h4>A plan for keeping more of what you earn</h4><p>Smart tax planning means more money stays with you.</p></div><a href="/tax-planning/" class="hv-service__link">Learn more about tax planning <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg></a></article>
        <article class="hv-service fade-up"><h3>Risk planning</h3><div class="hv-service__main"><h4>A plan for when life doesn't go to plan</h4><p>The right cover so your family's lifestyle is protected, no matter what.</p></div><a href="/risk-planning/" class="hv-service__link">Learn more about risk planning <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg></a></article>
        <article class="hv-service fade-up"><h3>Estate planning</h3><div class="hv-service__main"><h4>A plan for the people who matter most</h4><p>A clear plan so your loved ones are provided for.</p></div><a href="/estate-planning/" class="hv-service__link">Learn more about estate planning <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg></a></article>
      </div>
    </div>
  </section>

  <!-- Why Choose Us -->
  <section class="section hv-paper" id="why">
    <div class="container hv-split">
      <div class="hv-split__intro fade-up">
        <h2>Why people choose <em>Simple Wealth</em></h2>
        <p>Clients choose us because we put their goals first, speak in plain English, and provide advice they can trust.</p>
      </div>
      <ol class="hv-split__body hv-reasons">
        <li class="hv-reason fade-up"><span class="hv-reason__number">1</span><div><h3>Independent, advice-first approach</h3><p>We don't sell products. We give advice that's right for you.</p></div></li>
        <li class="hv-reason fade-up"><span class="hv-reason__number">2</span><div><h3>Personalised planning, not one-size-fits-all</h3><p>A plan designed around your goals and circumstances.</p></div></li>
        <li class="hv-reason fade-up"><span class="hv-reason__number">3</span><div><h3>Clear communication, no jargon</h3><p>We explain everything in plain language so you always know where you stand.</p></div></li>
        <li class="hv-reason fade-up"><span class="hv-reason__number">4</span><div><h3>Ongoing proactive support, not set-and-forget</h3><p>We stay involved and adjust your plan as life and markets change.</p></div></li>
      </ol>
    </div>
  </section>

  <!-- How We Work With You -->
  <section class="section" id="process">
    <div class="container">
      <div class="hv-lede hv-lede--center fade-up">
        <h2>How we work with you</h2>
        <p>A proactive process designed for every stage of life.</p>
      </div>
      <ol class="hv-timeline">
        <li class="hv-step fade-up"><span class="hv-step__number">1</span><h3>Introductory call</h3><p>A 10-minute call to see if our expertise matches your needs.</p></li>
        <li class="hv-step fade-up"><span class="hv-step__number">2</span><h3>Family meeting</h3><p>A 90-minute meeting (in-person or virtual) to understand your family goals, needs, and concerns.</p></li>
        <li class="hv-step fade-up"><span class="hv-step__number">3</span><h3>Review assessment</h3><p>A follow-up meeting to discuss our findings and recommendations.</p></li>
        <li class="hv-step fade-up"><span class="hv-step__number">4</span><h3>Annual service calendar</h3><p>Four annual touchpoints to keep your plan on track as life and markets evolve.<br><a href="/files/2026-simple-wealth-client-service-calendar.pdf" target="_blank" rel="noopener" class="card__link">View our service calendar <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg></a></p></li>
      </ol>
      <div class="hv-cta hv-cta--center fade-up"><a href="/contact/" class="btn btn--primary">Book a free call</a></div>
    </div>
  </section>

  <!-- What You Get -->
  <section class="section hv-navy">
    <div class="container">
      <div class="hv-lede hv-lede--center fade-up">
        <h2>Get <em>crystal-clear</em> financial understanding</h2>
        <p>Here's what you can expect from working with us.</p>
      </div>
      <div class="hv-sheets">
        <div class="hv-sheet fade-up"><span class="hv-icon"><svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14.5 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7.5L14.5 2z"/><polyline points="14 2 14 8 20 8"/></svg></span><h3>Your financial life on one page</h3><p>Always know what you have and why you have it.</p></div>
        <div class="hv-sheet fade-up"><span class="hv-icon"><svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 3v18h18"/><path d="m19 9-5 5-4-4-3 3"/></svg></span><h3>A financial progress report</h3><p>Always know where you are and where you're going.</p></div>
        <div class="hv-sheet fade-up"><span class="hv-icon"><svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2"/><path d="m9 12 2 2 4-4"/></svg></span><h3>A one-page action plan</h3><p>Always know what to do next.</p></div>
      </div>
    </div>
  </section>

  <LeadMagnet />

  <!-- FAQ -->
  <section class="section hv-faq" id="faq">
    <div class="container hv-split">
      <div class="hv-split__intro fade-up">
        <h2>A few questions our clients normally ask us</h2>
      </div>
      <div class="hv-split__body">
      <div class="faq-list fade-up">
        <div class="faq-item"><button class="faq-question">Do you only work with high-net-worth individuals?<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m6 9 6 6 6-6"/></svg></button><div class="faq-answer"><div class="faq-answer__inner"><p>While we serve many clients with significant assets, we provide a professional and proactive financial planning service to any family willing to engage and pay for professional advice. We don't have account minimums, but our minimum annual fee means that clients with investable assets below R2 million may not find our service cost-effective.</p></div></div></div>
        <div class="faq-item"><button class="faq-question">What does this cost and what exactly am I paying for?<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m6 9 6 6 6-6"/></svg></button><div class="faq-answer"><div class="faq-answer__inner"><p>We charge a percentage-based fee on your investable assets. This covers our comprehensive proactive service across investments, tax, estate planning, and risk planning. We are not remunerated by any product providers, so our incentives are fully aligned with yours. Clients are free to disengage at any time if the perceived value is less than our fee.</p></div></div></div>
        <div class="faq-item"><button class="faq-question">How do I know you're acting in my best interest?<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m6 9 6 6 6-6"/></svg></button><div class="faq-answer"><div class="faq-answer__inner"><p>As a client-centred firm with no outside influence from product providers, our only incentive is to provide professional advice that results in happy clients.</p></div></div></div>
        <div class="faq-item"><button class="faq-question">What kind of results should I realistically expect?<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m6 9 6 6 6-6"/></svg></button><div class="faq-answer"><div class="faq-answer__inner"><p>If you actively engage with our services, you should expect long-term peace of mind and progress towards your goals. The portfolios we build are typically focused on long-term growth, which inevitably means short-term volatility and temporary declines from time to time. Our service is designed for families who understand that long-term planning requires discipline and patience.</p></div></div></div>
        <div class="faq-item"><button class="faq-question">How often will we review things, and how quickly can I reach you?<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m6 9 6 6 6-6"/></svg></button><div class="faq-answer"><div class="faq-answer__inner"><p>Our <a href="/files/2026-simple-wealth-client-service-calendar.pdf" target="_blank" rel="noopener">service calendar</a> provides quarterly touchpoints, but we remain available for questions at any time in between. You can expect responses within one business day, and we proactively reach out when market conditions or life changes warrant a conversation. We have purposefully built a service model and client base that allow us to be available to our clients.</p></div></div></div>
      </div>
